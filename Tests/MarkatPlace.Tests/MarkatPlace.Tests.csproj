    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\Core\Services\Services.csproj" />
    <ProjectReference Include="..\..\Core\ServicesAbstraction\ServicesAbstraction.csproj" />
    <ProjectReference Include="..\..\Infastrucre\Presitance\Presitance.csproj" />
    <ProjectReference Include="..\..\Infastrucre\Presantion\Presantion.csproj" />
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
    <ProjectReference Include="..\..\MarkatPlace\MarkatPlace.csproj" />
  </ItemGroup>

</Project>
